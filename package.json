{
  "name": "icb-clean",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room IJUSTABABY command center and read-only stream overlay",
  "scripts": {
    "check:structure": "node tools/check-source.js",
    "setup:hooks": "node tools/install-hooks.js",
    "prepare": "node tools/install-hooks.js",
    "start": "node local-server/src/index.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test local-server/test/unit/*.test.js cloud-server/test/*.test.js",
    "setup:cloud": "npm ci --prefix cloud-server --ignore-scripts",
    "test:e2e": "node local-server/test/e2e.js",
    "test:browser": "node ui/test/browser.js",
    "images:plan": "node local-server/tools/cloudinary-sync.js --dry-run",
    "images:sync": "node local-server/tools/cloudinary-sync.js --upload",
    "images:download:plan": "node local-server/tools/cloudinary-download.js --dry-run",
    "images:download": "node local-server/tools/cloudinary-download.js --download",
    "format:js": "npx --yes --package prettier@2.8.4 --package acorn@8.12.1 -c \"node tools/format-javascript.js --write\"",
    "format:check": "npx --yes --package prettier@2.8.4 --package acorn@8.12.1 -c \"node tools/format-javascript.js --check\""
  }
}
