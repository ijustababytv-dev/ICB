# Copy to terraform.tfvars (ignored), then customize non-secret settings.
aws_region    = "us-east-1"
db_identifier = "baby-icb-postgres"

# Optional username override; leave unset here when using TF_VAR_db_username.
# db_username = "icbadmin"

# Requested public access; replace with ["YOUR.PUBLIC.IP/32"] to restrict later.
allowed_ipv4_cidrs = ["0.0.0.0/0"]

# Supply db_password privately, never in this file.
db_password_version       = 1
deletion_protection       = true
final_snapshot_identifier = "baby-icb-final"

# Phase A: foundations only. See README.md Phase B before enabling the real API.
activity_api_enabled = false

# Optional existing SNS topics for alarms; defaults to CloudWatch-only.
# alarm_action_arns = ["arn:aws:sns:us-east-1:123456789012:operations"]
